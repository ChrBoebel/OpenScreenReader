    },
    "The recording could not be processed. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht verarbeitet werden. Bitte versuche es erneut."
          }
        }
      }
    },
    "The recording is too large to process.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist zu groß für die Verarbeitung."
          }
        }
      }
    },
    "The region could not be captured. Check Screen Recording permission and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bereich konnte nicht erfasst werden. Prüfe die Freigabe für Bildschirmaufnahme und versuche es erneut."
          }
        }
      }
    },
    "The result is in the dictation window. Nothing was pasted automatically.": {
      "localizations": {
