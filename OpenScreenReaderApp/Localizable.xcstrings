    "Volume": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärke"
          }
        }
      }
    },
    "Wait 2 seconds before restoring the clipboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2 Sekunden warten, bevor die Zwischenablage wiederhergestellt wird"
          }
        }
      }
    },
    "Waiting for %@. You can return to Model to change your choice.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf %@. Unter „Modell“ kannst du deine Auswahl ändern."
          }
        }
      }
    },
    "Waiting for next text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf nächsten Text"
          }
        }
      }
    },
    "Waiting for the next text. Escape stops.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf den nächsten Text. Esc stoppt."
          }
        }
      }
    },
    "Welcome to Saywing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei Saywing"
          }
        }
      }
    },
    "Without Input Monitoring, Escape stops reading only while Saywing is in front. The stop button always works.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Eingabeüberwachung stoppt Esc das Vorlesen nur, wenn Saywing im Vordergrund ist. Die Stop-Taste funktioniert immer."
          }
        }
      }
    },
    "Write with your voice": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Stimme schreiben"
          }
        }
      }
    },
    "Your progress is saved, including when Saywing restarts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fortschritt bleibt gespeichert – auch nach einem Neustart."
          }
        }
      }
    },
    "Your reading voice": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Vorlesestimme"
          }
        }
      }
    },
    "macOS may need Saywing to restart before new access takes effect. You will continue at this step.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicherweise muss Saywing neu starten, damit die neue Freigabe wirksam wird. Danach geht es an dieser Stelle weiter."
          }
        }
      }
    },
    "⌥⇧Space": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⇧Leertaste"
          }
        }
      }
    },
    "⌥⇧Space is in use by another app; use the Record button.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⇧Leertaste wird von einer anderen App verwendet; nutze die Aufnahmetaste."
          }
        }
      }
    },
    "⌥⇧Space is reserved for dictation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⇧Leertaste ist für das Diktieren reserviert."
          }
        }
      }
    },
    "⌥⇧Space is reserved for dictation. Choose another reading shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥⇧Leertaste ist für das Diktieren reserviert. Wähle einen anderen Vorlese-Kurzbefehl."
          }
        }
      }
    }
  },
  "version": "1.0"
}
