          }
        }
      }
    },
    "The target changed. The result stays available in the dictation window.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ziel hat sich geändert. Das Ergebnis bleibt im Diktierfenster verfügbar."
          }
        }
      }
    },
    "This build is missing model resources. Reinstall Saywing to restore them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Version fehlen Modelldateien. Installiere Saywing erneut, um sie wiederherzustellen."
          }
        }
      }
    },
    "This development version reads up to 8,000 characters. Select a smaller region.": {
      "localizations": {
