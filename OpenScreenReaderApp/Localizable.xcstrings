            "state": "translated",
            "value": "Diese Entwicklungsversion liest bis zu 8.000 Zeichen. Wähle einen kleineren Bereich."
          }
        }
      }
    },
    "This kind of field is not supported yet. Use the test field instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Art von Feld wird noch nicht unterstützt. Verwende stattdessen das Testfeld."
          }
        }
      }
    },
    "This microphone format is not supported yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Mikrofonformat wird noch nicht unterstützt."
          }
        }
      }
    },
    "This session only · nothing is saved": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für diese Sitzung · nichts wird gespeichert"
          }
