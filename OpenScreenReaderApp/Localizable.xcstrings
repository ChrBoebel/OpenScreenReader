    },
    "The sample recording is invalid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hörprobe ist ungültig."
          }
        }
      }
    },
    "The selected region is invalid. Please select it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgewählte Bereich ist ungültig. Bitte wähle ihn erneut aus."
          }
        }
      }
    },
    "The shortcut %@ is already in use. Quit any other Saywing or OpenScreenReader copy, then choose it again under Settings › Shortcuts, or record a different one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
