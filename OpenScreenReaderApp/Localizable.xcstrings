{
  "sourceLanguage": "en",
  "strings": {
    "%@ is in use by another app; choose another shortcut in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird von einer anderen App verwendet. Wähle in den Einstellungen einen anderen Kurzbefehl."
          }
        }
      }
    },
    "%@ loads automatically and stays ready while Saywing is open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lädt automatisch und bleibt bereit, solange Saywing geöffnet ist."
          }
        }
      }
    },
    "%@ may replace a familiar command in other apps while Saywing is running. Use it anyway?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann einen vertrauten Befehl in anderen Apps ersetzen, solange Saywing läuft. Trotzdem verwenden?"
          }
        }
      }
    },
    "%@ not installed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nicht installiert"
          }
        }
      }
    },
    "%lld texts waiting": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld text waiting"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld texts waiting"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Text wartet"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Texte warten"
                }
              }
            }
          }
        }
      }
    },
    "%lld waiting in the queue": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld in der Warteschlange"
          }
        }
      }
    },
    "A downloaded model file did not match its pinned checksum.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine geladene Modelldatei stimmt nicht mit ihrer festgelegten Prüfsumme überein."
          }
        }
      }
    },
    "Access is allowed. Use the test to check that everything works.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff ist erlaubt. Prüfe mit dem Test, ob alles funktioniert."
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen"
          }
        }
      }
    },
    "Accessibility not allowed, so text can only be pasted into this window.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen nicht freigegeben – Text kann nur in dieses Fenster eingefügt werden."
          }
        }
      }
    },
    "Activity": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivität"
          }
        }
      }
    },
    "Add Screen Region to Queue…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmbereich zur Warteschlange hinzufügen…"
          }
        }
      }
    },
    "Add shortcut %@ is active and saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen-Kurzbefehl %@ ist aktiv und gespeichert."
          }
        }
      }
    },
    "Add to queue": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Warteschlange"
          }
        }
      }
    },
    "Added to queue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Warteschlange hinzugefügt."
          }
        }
      }
    },
    "Additional dictation models are downloaded from Hugging Face only when you choose to install one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitere Diktiermodelle werden nur dann von Hugging Face geladen, wenn du eines installierst."
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweitert"
          }
        }
      }
    },
    "Allow (Optional)…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigeben (optional)…"
          }
        }
      }
    },
    "Allow Accessibility to dictate into other apps. The test field already works.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Bedienungshilfen frei, um in anderen Apps zu diktieren. Das Testfeld funktioniert bereits."
          }
        }
      }
    },
    "Allow Input Monitoring in Settings so Escape can stop capture and text recognition while another app is active.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib in den Einstellungen die Eingabeüberwachung frei, damit Esc Aufnahme und Texterkennung auch in anderen Apps stoppt."
          }
        }
      }
    },
    "Allow Screen Recording in Settings to capture the selected region.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib in den Einstellungen die Bildschirmaufnahme frei, damit der ausgewählte Bereich erfasst werden kann."
          }
        }
      }
    },
    "Allow access in System Settings, then return here. Saywing checks automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff in den Systemeinstellungen und kehre hierher zurück. Saywing prüft die Freigabe automatisch."
          }
        }
      }
    },
    "Allow the microphone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon freigeben"
          }
        }
      }
    },
    "Allow the microphone in Setup, then start recording again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das Mikrofon in der Einrichtung frei und starte die Aufnahme dann erneut."
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigegeben"
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigeben…"
          }
        }
      }
    },
    "Already allowed access, but it still does not work?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff schon erlaubt, aber es funktioniert noch nicht?"
          }
        }
      }
    },
    "Also dictate with Fn": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch mit Fn diktieren"
          }
        }
      }
    },
    "Audio and text stay in memory until you discard them or quit. Pasting briefly uses the clipboard and then restores it, unless you copied something newer. Up to 60 seconds per recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio und Text bleiben im Arbeitsspeicher, bis du sie verwirfst oder Saywing beendest. Beim Einfügen wird die Zwischenablage kurz benutzt und danach wiederhergestellt, außer du hast inzwischen etwas Neueres kopiert. Höchstens 60 Sekunden pro Aufnahme."
          }
        }
      }
    },
    "Audio could not be passed to the local model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio konnte nicht an das lokale Modell übergeben werden."
          }
        }
      }
    },
    "Automatic (German / English)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch (Deutsch / Englisch)"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück"
          }
        }
      }
    },
    "Bottom": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten"
          }
        }
      }
    },
    "Bundled · offline development preview": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitgeliefert · Offline-Entwicklungsvorschau"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Can’t read aloud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlesen nicht möglich"
          }
        }
      }
    },
    "Capture or text recognition timed out. Please try a smaller region.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme oder Texterkennung hat zu lange gedauert. Bitte wähle einen kleineren Bereich."
          }
        }
      }
    },
    "Captures only the region you mark, for local text recognition.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst nur den Bereich, den du markierst – für die lokale Texterkennung."
          }
        }
      }
    },
    "Capturing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassen"
          }
        }
      }
    },
    "Check Again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut prüfen"
          }
        }
      }
    },
    "Check needs attention": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfung braucht Aufmerksamkeit"
          }
        }
      }
    },
    "Checking model files…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelldateien werden geprüft …"
          }
        }
      }
    },
    "Choose a key and at least Command, Option, or Control. Escape is reserved for cancellation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Taste und mindestens Befehl, Wahl oder Control. Esc ist für den Abbruch reserviert."
          }
        }
      }
    },
    "Choose a valid additional shortcut different from the primary shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen gültigen zusätzlichen Kurzbefehl, der sich vom Haupt-Kurzbefehl unterscheidet."
          }
        }
      }
    },
    "Choose an additional shortcut different from the primary shortcut. The primary shortcut and menu action remain available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen zusätzlichen Kurzbefehl, der sich vom Haupt-Kurzbefehl unterscheidet. Haupt-Kurzbefehl und Menübefehl bleiben verfügbar."
          }
        }
      }
    },
    "Choose position": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Position wählen"
          }
        }
      }
    },
    "Choose your shortcuts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deine Kurzbefehle"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeren"
          }
        }
      }
    },
    "Click a shortcut field and press your combination. Escape cancels the change; activation shortcuts are paused while you choose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf ein Kurzbefehl-Feld und drücke deine Tastenkombination. Escape bricht die Änderung ab. Während der Auswahl sind die Aktivierungskurzbefehle ausgesetzt."
          }
        }
      }
    },
    "Click in a text field and hold Fn, or use the test field here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in ein Textfeld und halte Fn – oder nutze hier das Testfeld."
          }
        }
      }
    },
    "Click in the test field or a text field in another app first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke zuerst in das Testfeld oder in ein Textfeld einer anderen App."
          }
        }
      }
    },
    "Click in the test field, hold Fn while you speak and release to paste. Press Fn twice for hands-free dictation and Fn again to finish. Escape discards. Without Fn, use ⌥⇧Space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in das Testfeld, halte Fn beim Sprechen und lass los, um einzufügen. Fn zweimal drücken diktiert freihändig, erneut Fn beendet. Esc verwirft. Ohne Fn: ⌥⇧Leertaste."
          }
        }
      }
    },
    "Click the field and press a new combination. Press the shortcut again while Saywing reads to add another region; Escape stops everything.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in das Feld und drücke eine neue Kombination. Drückst du den Kurzbefehl während des Vorlesens erneut, kommt ein weiterer Bereich hinzu; Esc stoppt alles."
          }
        }
      }
    },
    "Click, then type a new shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, dann neuen Kurzbefehl drücken."
          }
        }
      }
    },
    "Close notice": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis schließen"
          }
        }
      }
    },
    "Close status": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Status schließen"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter"
          }
        }
      }
    },
    "Control position": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Position der Steuerung"
          }
        }
      }
    },
    "Copy Result": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnis kopieren"
          }
        }
      }
    },
    "Dictate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren"
          }
        }
      }
    },
    "Dictate into other apps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In andere Apps diktieren"
          }
        }
      }
    },
    "Dictate · %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren · %@"
          }
        }
      }
    },
    "Dictate, release to paste": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren, loslassen zum Einfügen"
          }
        }
      }
    },
    "Dictate: Hold Fn": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren: Fn halten"
          }
        }
      }
    },
    "Dictation Settings…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiereinstellungen…"
          }
        }
      }
    },
    "Dictation is not available in this build.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren ist in diesem Build nicht verfügbar."
          }
        }
      }
    },
    "Dictation on your Mac": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren auf deinem Mac"
          }
        }
      }
    },
    "Dictation paused": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren pausiert"
          }
        }
      }
    },
    "Dictation test field": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktier-Testfeld"
          }
        }
      }
    },
    "Dictation · %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren · %@"
          }
        }
      }
    },
    "Discard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwerfen"
          }
        }
      }
    },
    "Discard (Esc)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwerfen (Esc)"
          }
        }
      }
    },
    "Discard Dictation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat verwerfen"
          }
        }
      }
    },
    "Discard dictation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat verwerfen"
          }
        }
      }
    },
    "Discarded": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verworfen"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "Download %@ from Hugging Face (%@). Every file is checked before use. Recordings and text stay on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade %@ von Hugging Face (%@). Jede Datei wird vor der Verwendung geprüft. Aufnahmen und Text bleiben auf deinem Mac."
          }
        }
      }
    },
    "Download and Install": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden und installieren"
          }
        }
      }
    },
    "Download progress": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download-Fortschritt"
          }
        }
      }
    },
    "Downloading %@…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird geladen …"
          }
        }
      }
    },
    "Download…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden …"
          }
        }
      }
    },
    "Drag over text or click a paragraph  ·  Space moves  ·  Esc cancels": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Text ziehen oder Absatz anklicken  ·  Leertaste verschiebt  ·  Esc bricht ab"
          }
        }
      }
    },
    "Drag over the text to read, or click a paragraph. Hold Space to move the selection, Shift to lock an edge, Option to grow it from the centre. Press Escape to cancel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe über den Text, der vorgelesen werden soll, oder klicke einen Absatz an. Leertaste halten verschiebt die Auswahl, Umschalt fixiert eine Kante, Wahl vergrößert sie von der Mitte aus. Esc bricht ab."
          }
        }
      }
    },
    "Drag the waveform to a screen edge": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellenform an einen Bildschirmrand ziehen"
          }
        }
      }
    },
    "Enables Fn dictation and pastes text into the app you were using.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht Diktieren mit Fn und fügt Text in die zuvor verwendete App ein."
          }
        }
      }
    },
    "Entirely on this Mac": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles lokal auf diesem Mac"
          }
        }
      }
    },
    "Error": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler"
          }
        }
      }
    },
    "Escape": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc"
          }
        }
      }
    },
    "Escape always stops reading or discards dictation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape stoppt jederzeit das Vorlesen oder verwirft das Diktat."
          }
        }
      }
    },
    "Escape discards this dictation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc verwirft dieses Diktat."
          }
        }
      }
    },
    "Escape is in use by another app. Recording did not start; quit the other dictation app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc wird von einer anderen App verwendet. Die Aufnahme wurde nicht gestartet; beende die andere Diktier-App."
          }
        }
      }
    },
    "Escape stops everything and clears the queue": {
      "localizations": {
