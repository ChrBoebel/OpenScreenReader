          }
        }
      }
    },
    "Try reading aloud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlesen ausprobieren"
          }
        }
      }
    },
    "Two public sample recordings tested recognition, pasting and restoring. Your microphone was not used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei öffentliche Hörproben haben Erkennung, Einfügen und Wiederherstellung geprüft. Dein Mikrofon wurde nicht verwendet."
          }
        }
      }
    },
    "Type Shortcut": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehl drücken"
          }
        }
      }
    },
    "Up Next · %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes · %lld"
          }
        }
      }
    },
    "Use Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell verwenden"
          }
        }
      }
    },
    "Use Shortcut": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehl verwenden"
          }
        }
      }
    },
    "Use a letter, digit or Space with ⌘, ⌥ or ⌃. Shift is optional.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende einen Buchstaben, eine Ziffer oder die Leertaste mit ⌘, ⌥ oder ⌃. Umschalt ist optional."
          }
        }
      }
    },
    "Use your microphone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon freigeben"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        }
      }
    },
    "Voice": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimme"
          }
        }
      }
