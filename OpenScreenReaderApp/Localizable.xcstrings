            "state": "translated",
            "value": "Das Ergebnis steht im Diktierfenster. Es wurde nichts automatisch eingefügt."
          }
        }
      }
    },
    "The sample recording could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
